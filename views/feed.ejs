<% include ./partials/header.ejs %>

    <div class="container" style="margin: 10px;">
      <% allposts.reverse().forEach(function(post){ %>
        <div class="card mt-2" style="width: 14rem; background-color: transparent; border: none;">
            <span class="border-black border border-3 rounded-4">
              <img style="width: 40px; height: 40px; border-radius: 50%; padding: 5px; margin: 3%;" src="<%= post.userid.image %>" alt="">
          <div class="lol" style="margin-left: 35px; margin-top: -33px;">
            <div class="card-body rounded" style="background-color: transparent; color: rgb(255, 255, 255);">
              <h5 class="card-title" style="margin-top: -29px;">username : <%= post.userid.username %></h5>
              <p class="card-text">data : <%= post.data %></p>
              </div>
          </div>
          <div class="lo" style="line-height: 8px; margin-left: 48px;">
          <p style="font-weight: 600; color: rgb(70, 55, 55); margin-left: 5px;">Likes : <%= post.likes.length %></p>
          <a href="/like/<%= post._id%>" style="margin-bottom: 20px;" class="btn <%= post.likes.indexOf(user.id)===-1 ? 'btn-primary' : 'btn-danger' %>"><%= post.likes.indexOf(user.id) === -1 ? 'Like' : 'Unlike' %></a>  
          </div>
        </div> 
    </span>
    <%})%>
    </div>

<% include ./partials/footer.ejs %>